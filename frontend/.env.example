# ===================================================================
# 🎨 FRONTEND CONFIGURATION (CHỈ DÀNH CHO FRONTEND)
# ===================================================================
# Lưu ý: Vite đã được cấu hình tự động đọc từ file .env ở thư mục gốc.
# Bạn chỉ cần tạo và cấu hình file này nếu muốn chạy frontend độc lập hoặc ghi đè (override).
# ⚠️ BẢO MẬT: KHÔNG đưa API Key (Gemini, DB password) vào đây vì code frontend chạy trên trình duyệt người dùng.

# Địa chỉ API của Backend mà Frontend gọi tới
VITE_API_BASE_URL=http://localhost:5000/api/v1
