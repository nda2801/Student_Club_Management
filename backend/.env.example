# ===================================================================
# 🖥️ BACKEND CƠ SỞ DỮ LIỆU & AI CONFIGURATION (CHỈ DÀNH CHO BACKEND)
# ===================================================================
# Lưu ý: Hệ thống đã cấu hình tự động đọc từ file .env ở thư mục gốc!
# Bạn chỉ cần tạo và cấu hình file này nếu muốn chạy backend độc lập hoặc ghi đè (override).

# 1. Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:postgrespassword2026@localhost:5432/student_club
# Hoặc SQLite: DATABASE_URL=sqlite:///student_club.db

# 2. JWT Secret Key
SECRET_KEY=bmad-super-secret-jwt-key-student-club-2026

# 3. AI Engine Keys (Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. Server Host & Port
PORT=5000
HOST=0.0.0.0
