# ===================================================================
# 🌐 DỰ ÁN QUẢN LÝ CLB SINH VIÊN TÍCH HỢP AI AGENT - CẤU HÌNH TỔNG (ROOT)
# ===================================================================
# Đây là file cấu hình tổng (Single Source of Truth).
# Các service Backend và Frontend sẽ tự động đọc từ file .env này.

# -------------------------------------------------------------------
# 1. Cấu hình Cơ sở dữ liệu (PostgreSQL / SQLite)
# -------------------------------------------------------------------
# Chạy với Docker / PostgreSQL:
DATABASE_URL=postgresql://postgres:postgrespassword2026@localhost:5432/student_club
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword2026
POSTGRES_DB=student_club
# Hoặc chạy thử nghiệm nhanh SQLite (bỏ comment dòng dưới):
# DATABASE_URL=sqlite:///student_club.db

# -------------------------------------------------------------------
# 2. Cấu hình Xác thực JWT
# -------------------------------------------------------------------
SECRET_KEY=bmad-super-secret-jwt-key-student-club-2026

# -------------------------------------------------------------------
# 3. Cấu hình AI Engine (Dùng chung cho toàn hệ thống)
# -------------------------------------------------------------------
# Lấy Gemini key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=
OPENAI_API_KEY=

# -------------------------------------------------------------------
# 4. Cấu hình Backend Server
# -------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0

# -------------------------------------------------------------------
# 5. Cấu hình Frontend (React Vite)
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
